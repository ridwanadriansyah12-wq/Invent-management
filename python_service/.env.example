# Python FastAPI Service — ML Inventory Engine
# Salin file ini ke .env dan isi nilai yang sesuai

# ── Database (MySQL yang sama dengan Laravel) ──────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rop
DB_USER=rop_python           # User khusus Python: SELECT stock_movements/items/categories,
                              # INSERT/UPDATE daily_demand, item_classifications, forecast_runs
DB_PASSWORD=secret_python_password

# ── API Security ───────────────────────────────────────────────────────────
# Harus sama persis dengan FASTAPI_API_KEY di Laravel .env
API_KEY=ganti_dengan_secret_key_yang_kuat_dan_panjang

# ── Pipeline Config ────────────────────────────────────────────────────────
IMPUTATION_WINDOW_DAYS=28
MIN_UNCENSORED_DAYS=14
MIN_HISTORY_DAYS_ML=30
CENSORED_TOLERANCE=0.0005

# ── Forecasting Config ─────────────────────────────────────────────────────
LUMPY_SIGMA_FACTOR=1.25       # Faktor pengali sigma untuk pola lumpy
BACKTEST_MIN_FOLDS=3
BACKTEST_HORIZON_DAYS=15      # Default = lead_time_days; overridden per item

# ── Service Config ─────────────────────────────────────────────────────────
CHUNK_SIZE=100                # Max SKU per batch request dari Laravel
REQUEST_TIMEOUT=120           # Timeout (detik) per chunk
LOG_LEVEL=INFO
